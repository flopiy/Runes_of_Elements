  _def:
    Id: boss_ice_queen
    Name: "\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0430 \u041B\u044C\u043E\u0434\u0443"
    Level: 4
    Hp: 30
    Attack: 4
    AbilityIds:
    - boss_queen_cold
    - boss_queen_armor
    - boss_queen_freeze
    AbilityName: "\u0411\u043E\u0441-\u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456"
    AbilityText: "\u0412\u0456\u0447\u043D\u0438\u0439 \u0445\u043E\u043B\u043E\u0434:
      \u043C\u0430\u0433\u0438 \u043F\u043E\u0447\u0438\u043D\u0430\u044E\u0442\u044C
      \u0445\u0456\u0434 \u0437 \u22121 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0456\u0454\u044E
      (\u043D\u0435 \u043D\u0438\u0436\u0447\u0435 1).\n\u041A\u0440\u0438\u0436\u0430\u043D\u0430
      \u0431\u0440\u043E\u043D\u044F: \u043F\u0435\u0440\u0448\u0438\u0439 \u0443\u0434\u0430\u0440
      \u0437\u0430 \u0440\u0430\u0443\u043D\u0434 \u22122.\n\u0417\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044F:
      \u0449\u043E\u0440\u0430\u0443\u043D\u0434\u0443 \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u0438\u0439
      \u043C\u0430\u0433 \u043F\u0456\u0434 \xAB\u041C\u043E\u0432\u0447\u0430\u043D\u043D\u044F\u043C\xBB
      \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E\u0457 \u0441\u0442\u0438\u0445\u0456\u0457."
  _portrait: {fileID: 21300000, guid: d9971d5a042d2344dbb0bf92660b5e3c, type: 3}

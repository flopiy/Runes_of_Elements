  _def:
    Id: boss_chaos_archmage
    Name: "\u0410\u0440\u0445\u0456\u043C\u0430\u0433 \u0425\u0430\u043E\u0441\u0443"
    Level: 4
    Hp: 28
    Attack: 4
    AbilityIds:
    - boss_chaos_warp
    - boss_chaos_reflect
    - boss_chaos_surge
    AbilityName: "\u0411\u043E\u0441-\u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456"
    AbilityText: "\u0412\u0438\u043A\u0440\u0438\u0432\u043B\u0435\u043D\u0430 \u043C\u0430\u0433\u0456\u044F:
      \u0449\u043E\u0440\u0430\u0443\u043D\u0434\u0443 \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u0430
      \u0441\u0442\u0438\u0445\u0456\u044F \u0434\u043E\u0440\u043E\u0436\u0447\u0430
      \u043D\u0430 1.\n\u0412\u0456\u0434\u0431\u0438\u0442\u0442\u044F: \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0438\u0439
      \u043C\u0430\u0433 \u043E\u0442\u0440\u0438\u043C\u0443\u0454 1 \u0448\u043A\u043E\u0434\u0438.\n\u0425\u0430\u043E\u0442\u0438\u0447\u043D\u0438\u0439
      \u0441\u043F\u043B\u0435\u0441\u043A: \u043A\u043E\u0436\u0435\u043D 3-\u0439
      \u0440\u0430\u0443\u043D\u0434 2 \u0448\u043A\u043E\u0434\u0438 \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E\u043C\u0443
      \u043C\u0430\u0433\u0443."

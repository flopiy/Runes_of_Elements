    AbilityName: "\u0411\u043E\u0441-\u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456"
    AbilityText: "\u041A\u0430\u043C'\u044F\u043D\u0430 \u0431\u0440\u043E\u043D\u044F:
      \u043A\u043E\u0436\u0435\u043D \u0443\u0434\u0430\u0440 \u22121.\n\u041D\u0435\u043F\u043E\u0445\u0438\u0442\u043D\u0456\u0441\u0442\u044C:
      \u0456\u043C\u0443\u043D\u0456\u0442\u0435\u0442 \u0434\u043E \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0438
      \u0439 \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u0435\u043D\u043D\u044F.\n\u0413\u043D\u0456\u0432
      \u0421\u0442\u0440\u0430\u0436\u0430: \u043F\u0440\u0438 10 \u0437\u0434\u043E\u0440\u043E\u0432'\u0457
      \u0456 \u043D\u0438\u0436\u0447\u0435 \u0430\u0442\u0430\u043A\u0430 \u0441\u0442\u0430\u0454
      6."

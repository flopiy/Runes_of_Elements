<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="RoE.uss" />
    <Style src="GameHud.uss" />
    <ui:VisualElement name="hud-root" class="roe-root" picking-mode="Ignore">

        <ui:VisualElement name="top-banner" class="hud-header">
            <ui:VisualElement class="hud-emblem">
                <ui:VisualElement class="hud-icon-earth hud-team-icon" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label name="tower-title" text="Поверх 1/10 · Хвиля 1/3" class="hud-header-title" />
                <ui:Label name="floor-name" text="Фортеця-обсерваторія" class="hud-header-sub" />
                <ui:Label name="turn-subtext" text="Раунд 1 · Хід: Піромант" class="hud-header-sub" />
            </ui:VisualElement>
            <ui:Button name="leave-btn" text="Меню" class="roe-btn hud-menu-btn" />
        </ui:VisualElement>

        <ui:VisualElement name="left-column" class="hud-left-column" picking-mode="Ignore">
            <ui:VisualElement class="hud-panel">
                <ui:Label text="Запас рун" class="hud-panel-title" />
                <ui:VisualElement name="pool-grid" class="hud-pool-grid" />
                <ui:Label name="pool-total" text="Усього: 18" class="hud-caption hud-pool-total" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView name="right-column" class="hud-right-column" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
            <ui:VisualElement name="hero-panel" class="hud-panel">
                <ui:VisualElement class="hud-hero-head">
                    <ui:Image name="hero-element" class="hud-hero-element" />
                    <ui:Label name="hero-name" text="Піромант" class="hud-hero-name" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-portrait-frame">
                    <ui:Image name="hero-portrait" class="hud-portrait" />
                    <ui:VisualElement class="hud-stats-row">
                        <ui:VisualElement class="hud-stat">
                            <ui:VisualElement class="hud-stat-icon hud-icon-heart" />
                            <ui:Label name="hero-hp" text="10" class="hud-stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="hud-stat">
                            <ui:VisualElement class="hud-conc-dot" />
                            <ui:Label name="hero-conc" text="3" class="hud-stat-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="hero-turn" text="Ваш хід" class="hud-caption" />
                <ui:Label text="Руни на картці" class="hud-subheader" />
                <ui:VisualElement class="hud-slot-row">
                    <ui:Button name="slot-el-0" class="hud-slot" />
                    <ui:Button name="slot-el-1" class="hud-slot" />
                    <ui:Button name="slot-form-0" class="hud-slot" />
                    <ui:Button name="slot-form-1" class="hud-slot" />
                </ui:VisualElement>
                <ui:Label text="Пасивна здатність" class="hud-subheader" />
                <ui:Label name="hero-passive" text="Палаюча сила: Вогонь коштує на 1 менше." class="hud-text-block" />
                <ui:VisualElement name="hero-statuses" class="hud-tags" />
            </ui:VisualElement>

            <ui:VisualElement name="team-panel" class="hud-panel">
                <ui:Label text="Команда" class="hud-panel-title" />
                <ui:VisualElement name="team-icons" class="hud-team-row" />
                <ui:VisualElement class="hud-team-summary">
                    <ui:Label name="team-hp" text="♥ 40 / 40" class="hud-value" />
                    <ui:Label name="team-effects" text="Ефектів немає" class="hud-caption" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:VisualElement name="spells-popup" class="hud-panel hud-spells-popup hud-hidden">
            <ui:Label text="Заклинання" class="hud-panel-title" />
            <ui:VisualElement name="spells-container" />
            <ui:Label name="spells-empty" text="Покладіть Стихію та Форму на картку мага, щоб скласти заклинання." class="hud-text-block" />
        </ui:VisualElement>

        <ui:VisualElement name="bottom-bar" class="hud-bottom-row" picking-mode="Ignore">
            <ui:VisualElement name="blessing-card" class="hud-blessing-card">
                <ui:VisualElement class="hud-blessing-top">
                    <ui:Label name="blessing-kind" text="Карта бафу" class="hud-blessing-kind" />
                    <ui:Label name="blessing-uses" text="" class="hud-blessing-uses" />
                </ui:VisualElement>
                <ui:Label name="blessing-name" text="Немає карти" class="hud-blessing-name" />
                <ui:Label name="blessing-desc" text="" class="hud-text-block" />
            </ui:VisualElement>

            <ui:VisualElement class="hud-panel hud-hand-panel">
                <ui:Label name="hand-header" text="Рука мага" class="hud-panel-title" />
                <ui:VisualElement name="hand-container" class="hud-hand-row" />
                <ui:Label name="hud-message" text="" class="hud-message" />
            </ui:VisualElement>

            <ui:VisualElement class="hud-panel hud-dice-panel">
                <ui:VisualElement class="hud-die">
                    <ui:VisualElement class="hud-die-face hud-icon-d8">
                        <ui:Label name="die-d8" text="–" class="hud-die-value" />
                    </ui:VisualElement>
                    <ui:Label text="Монстри" class="hud-caption hud-die-caption" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-die">
                    <ui:VisualElement class="hud-die-face hud-icon-d4">
                        <ui:Label name="die-d4" text="–" class="hud-die-value" />
                    </ui:VisualElement>
                    <ui:Label text="Цілі" class="hud-caption hud-die-caption" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-die">
                    <ui:VisualElement class="hud-die-face hud-icon-d6">
                        <ui:Label name="die-d6" text="–" class="hud-die-value" />
                    </ui:VisualElement>
                    <ui:Label text="Шкода" class="hud-caption hud-die-caption" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="actions-column" class="hud-actions">
                <ui:Button name="cryo-btn" text="Крижаний полон" class="hud-action-btn hud-action-btn--purple hud-hidden" />
                <ui:Button name="spells-btn" text="Заклинання" class="hud-action-btn hud-action-btn--gold" />
                <ui:Button name="meditate-btn" text="Медитувати" class="hud-action-btn hud-action-btn--blue" />
                <ui:Button name="pass-btn" text="Завершити хід" class="hud-action-btn hud-action-btn--gray" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="decision-overlay" class="roe-overlay hud-hidden">
            <ui:VisualElement class="roe-modal-box">
                <ui:Label text="РІШЕННЯ ЩОДО КИДКА" class="roe-modal-title" />
                <ui:Label name="decision-text" text="На кубику шкоди випало: 4" class="roe-modal-body" />
                <ui:VisualElement class="hud-modal-row">
                    <ui:Button name="decide-accept-btn" text="Прийняти" class="roe-btn roe-btn--primary" />
                    <ui:Button name="decide-reroll-btn" text="Перекинути (Щастя сортувальника)" class="roe-btn" />
                    <ui:Button name="decide-mirror-btn" text="Дзеркало фортуни (1↔6)" class="roe-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="flow-overlay" class="roe-overlay hud-hidden">
            <ui:VisualElement class="roe-modal-box">
                <ui:Label name="flow-title" text="ХВИЛЮ ВІДБИТО!" class="roe-modal-title" />
                <ui:Label name="flow-body" text="Загін отримує +3 здоров'я." class="roe-modal-body" />
                <ui:VisualElement name="flow-extra-actions" class="hud-flow-extra" />
                <ui:Button name="flow-continue-btn" text="Далі" class="roe-btn roe-btn--primary hud-flow-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

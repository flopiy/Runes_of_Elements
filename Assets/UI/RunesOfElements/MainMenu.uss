This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.menu-root { position: absolute; width: 100%; height: 100%; color: #E8DFD0; font-size: 13px; }
.menu-brand { position: absolute; left: 5%; top: 5%; }
.menu-brand-title { font-size: 28px; -unity-font-style: bold; color: #F5DDA7; }
.menu-brand-sub { font-size: 11px; color: #B7A4D6; margin-top: 4px; }
.menu-side { position: absolute; right: 5%; top: 0; bottom: 0; width: 30%; min-width: 260px; justify-content: center; }
.menu-title-panel { max-height: 94%; overflow: hidden; padding: 16px 20px; background-color: rgba(10, 12, 23, 0.92); border-width: 1px; border-color: #6D5A3E; border-radius: 8px; }
.menu-title-panel .menu-button { height: 32px; margin: 2px 0; }
.menu-title-panel .menu-small { height: 26px; }
.menu-eyebrow { font-size: 11px; color: #C7A465; margin-bottom: 8px; }
.menu-heading { font-size: 24px; -unity-font-style: bold; color: #F3DFC0; margin-bottom: 8px; }
.menu-copy { white-space: normal; font-size: 12px; color: #B6ADBE; margin-bottom: 12px; }
.menu-button { height: 38px; margin: 3px 0; padding: 6px 12px; background-color: #242137; border-width: 1px; border-color: #514866; border-radius: 4px; color: #ECE3D3; font-size: 13px; cursor: link; }
.menu-button:hover { background-color: #38304E; border-color: #B99965; }
.menu-button:focus { border-color: #E3BE7B; }
.menu-primary { background-color: #695029; border-color: #B58B44; }
.menu-primary:hover { background-color: #846437; }
.menu-button:disabled { opacity: 0.4; }
.menu-small { font-size: 11px; height: 28px; }
.menu-footer { position: absolute; left: 5%; bottom: 5%; color: #AF9ACB; font-size: 11px; }
.menu-hidden { display: none; }
.menu-overlay { position: absolute; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(4, 5, 12, 0.74); }
.menu-dialog { width: 70%; max-width: 740px; max-height: 90%; padding: 20px; border-width: 1px; border-color: #9B8055; border-radius: 7px; background-color: #111322; }
.menu-dialog-title { font-size: 21px; -unity-font-style: bold; color: #F0D7A6; margin-bottom: 6px; }
.menu-caption { font-size: 11px; color: #AEA0BC; margin-bottom: 8px; white-space: normal; }
.menu-seats { margin: 8px 0; }
.menu-seat { flex-direction: row; align-items: center; margin: 3px 0; }
.menu-seat-name { width: 24%; font-size: 12px; }
.menu-mage-select { flex-grow: 1; margin: 0 8px; }
.menu-seat-kind { width: 18%; }
.menu-options { flex-direction: row; margin: 8px 0; }
.menu-option { flex-grow: 1; margin-right: 6px; font-size: 11px; }
.menu-dialog-actions { flex-direction: row; justify-content: space-between; margin-top: 8px; }
.menu-back { width: 26%; }
.menu-start { width: 44%; }
.menu-rules-scroll { flex-shrink: 1; height: 330px; margin: 10px 0; }
.menu-rules-text { white-space: normal; color: #D6CFD9; font-size: 12px; }
.menu-online { margin-top: 10px; border-top-width: 1px; border-top-color: #393248; padding-top: 6px; }
.menu-online-row { flex-direction: row; }
.menu-code { flex-grow: 1; margin-right: 6px; }
.menu-code .unity-text-field__input { background-color: #1B192B; color: #E8DFD0; border-width: 1px; border-color: #514866; }

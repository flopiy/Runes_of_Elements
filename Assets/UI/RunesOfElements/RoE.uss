/* Root layout */
.roe-root {
    position: absolute;
    width: 100%;
    height: 100%;
    font-size: 14px;
    color: #E6E1D8;
    justify-content: space-between;
}

/* Top Banner */
.roe-top-banner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(18, 14, 24, 0.88);
    border-bottom-width: 2px;
    border-bottom-color: #8C6F3D;
    padding: 8px 18px;
    height: 48px;
}

.roe-title-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: #F7D58B;
    letter-spacing: 1px;
}

.roe-sub-text {
    font-size: 13px;
    color: #BDB6A8;
}

/* Middle Game Area */
.roe-middle-row {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 1;
    padding: 10px;
}

/* Left & Right Panels */
.roe-panel {
    background-color: rgba(15, 12, 22, 0.90);
    border-width: 1.5px;
    border-color: #5A472A;
    border-radius: 6px;
    padding: 10px;
}

.roe-left-panel {
    width: 270px;
    max-height: 82%;
}

.roe-right-panel {
    width: 330px;
    max-height: 85%;
}

.roe-section-header {
    font-size: 13px;
    -unity-font-style: bold;
    color: #E2B765;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: #3D311E;
    padding-bottom: 3px;
}

/* Unit Cards in Left Panel */
.roe-mage-card {
    background-color: rgba(28, 22, 38, 0.85);
    border-width: 1px;
    border-color: #4A3A22;
    border-radius: 4px;
    padding: 6px 8px;
    margin-bottom: 6px;
}

.roe-mage-card--active {
    border-color: #F7D58B;
    background-color: rgba(50, 36, 68, 0.95);
}

.roe-mage-card--eliminated {
    opacity: 0.45;
}

.roe-bar-bg {
    height: 14px;
    background-color: rgba(20, 15, 15, 0.8);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 3px;
    margin-bottom: 3px;
    border-width: 1px;
    border-color: #332615;
}

.roe-hp-bar-fill {
    height: 100%;
    background-color: #C0392B;
    border-radius: 2px;
}

.roe-conc-bar-fill {
    height: 100%;
    background-color: #9B59B6;
    border-radius: 2px;
}

/* Slot Boxes */
.roe-slot-box {
    width: 68px;
    height: 68px;
    border-width: 1.5px;
    border-color: #6A522F;
    border-radius: 5px;
    background-color: rgba(24, 18, 32, 0.9);
    align-items: center;
    justify-content: center;
    margin: 4px;
}

.roe-slot-box--selected {
    border-color: #F1C40F;
    border-width: 2.5px;
}

/* Rune Chips in Hand */
.roe-rune-chip {
    padding: 6px 10px;
    margin: 3px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #7D6335;
    background-color: #2D203A;
    -unity-font-style: bold;
    color: #FFF;
    cursor: link;
}

.roe-rune-chip:hover {
    background-color: #4A365D;
    border-color: #F7D58B;
}

.roe-rune-chip--selected {
    border-color: #F39C12;
    background-color: #5D3E1A;
}

/* Buttons */
.roe-btn {
    background-color: #3A2B1A;
    border-color: #8C6F3D;
    border-width: 1.5px;
    border-radius: 5px;
    padding: 8px 14px;
    margin: 4px 2px;
    color: #F5E6CC;
    -unity-font-style: bold;
    cursor: link;
    transition-duration: 0.1s;
}

.roe-btn:hover {
    background-color: #543E26;
    border-color: #D4AF37;
    color: #FFFFFF;
}

.roe-btn:active {
    background-color: #261B0F;
}

.roe-btn--primary {
    background-color: #5C2D16;
    border-color: #E67E22;
}

.roe-btn--primary:hover {
    background-color: #7A3C1E;
    border-color: #F39C12;
}

.roe-btn--disabled {
    opacity: 0.45;
    border-color: #4A4A4A;
    background-color: #2A2A2A;
}

/* Bottom Event Log */
.roe-bottom-bar {
    background-color: rgba(14, 11, 18, 0.92);
    border-top-width: 2px;
    border-top-color: #5A472A;
    padding: 6px 14px;
    height: 90px;
    flex-direction: row;
    justify-content: space-between;
}

.roe-log-scroll {
    flex-grow: 1;
    margin-right: 14px;
}

.roe-log-line {
    font-size: 12px;
    color: #CFC7B8;
    margin-bottom: 2px;
}

/* Overlays / Modals */
.roe-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 3, 8, 0.75);
    align-items: center;
    justify-content: center;
}

.roe-modal-box {
    width: 480px;
    background-color: rgba(22, 16, 30, 0.98);
    border-width: 2.5px;
    border-color: #C49B45;
    border-radius: 8px;
    padding: 22px;
    align-items: center;
}

.roe-modal-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #F7D58B;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.roe-modal-body {
    font-size: 14px;
    color: #D8D2C4;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    white-space: normal;
}
